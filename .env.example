# Active database URL used by app/Prisma commands (defaults to local)
DATABASE_URL="postgresql://user:password@localhost:5432/knowledgeai?schema=public"

# Two-database setup helpers
DATABASE_URL_LOCAL="postgresql://user:password@localhost:5432/knowledgeai?schema=public"
DATABASE_URL_ONLINE="postgresql://postgres:replace-with-supabase-password@db.your-project-ref.supabase.co:5432/postgres"
AUTH_SECRET="replace-with-a-long-random-string"
REDIS_URL="redis://127.0.0.1:6379"
AUTH_LOGIN_MAX_ATTEMPTS="5"
AUTH_LOGIN_WINDOW_SECONDS="300"
AUTH_OTP_REQUEST_MAX_ATTEMPTS="3"
AUTH_OTP_REQUEST_WINDOW_SECONDS="300"
AUTH_REGISTER_MAX_ATTEMPTS="5"
AUTH_REGISTER_WINDOW_SECONDS="900"
QDRANT_URL="https://6a300423-2d1f-491a-a374-9c7da8d19b9c.sa-east-1-0.aws.cloud.qdrant.io"
QDRANT_API_KEY="replace-with-qdrant-api-key"
QDRANT_COLLECTION="knowledgeai-article-chunks"
EMBEDDING_PROVIDER="qwen"
EMBEDDING_API_KEY="replace-with-embedding-api-key"
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
OPENAI_API_KEY="replace-with-openai-api-key"
EMBEDDING_MODEL="text-embedding-3-small"
AI_WRITER_MODEL="qwen-plus"
AI_REVIEW_MODEL="qwen-plus"
AI_WRITER_MAX_CHARS="2000"
SEARCH_SEMANTIC_MIN_SCORE="0.30"

# Local PostgreSQL / Supabase helper:
# - DATABASE_URL_LOCAL="postgresql://knowledgeai:knowledgeai_dev@127.0.0.1:5432/knowledgeai?schema=public"
# - DATABASE_URL_ONLINE="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# Redis is optional. If omitted, the app falls back to direct DB reads.
# Qdrant/OpenAI will be used by the real semantic retrieval integration.
# EMBEDDING_API_KEY takes priority; OPENAI_API_KEY is kept for backward compatibility.
# Qwen (compatible mode) example:
# EMBEDDING_PROVIDER="qwen"
# EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
